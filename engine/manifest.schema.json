{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motf.local/schemas/mobile-engine-manifest.schema.json",
  "title": "MOTF Mobile Engine Model Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelId", "mode", "version", "runtime", "files", "input", "output"],
  "properties": {
    "modelId": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "string",
      "enum": ["onnxruntime", "coreml", "litert", "executorch", "custom"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleRate", "channels", "format"],
      "properties": {
        "sampleRate": { "type": "integer", "enum": [16000, 22050, 44100, 48000] },
        "channels": { "type": "integer", "enum": [1, 2] },
        "format": { "type": "string", "enum": ["float32", "float16", "int16"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stems"],
      "properties": {
        "stems": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "attribution": { "type": "string" },
        "redistributable": { "type": "boolean" }
      }
    },
    "notes": { "type": "string" }
  }
}